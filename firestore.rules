rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // ヘルパー関数
    // ========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getFamilyId() {
      return get(/databases/$(database)/documents/family_members/$(request.auth.uid)).data.family_id;
    }

    function belongsToFamily(familyId) {
      return isAuthenticated() && getFamilyId() == familyId;
    }

    function isParent() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/family_members/$(request.auth.uid)).data.role == 'parent';
    }

    function isChild() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/family_members/$(request.auth.uid)).data.role == 'child';
    }

    function getUserFamilyId(userId) {
      return get(/databases/$(database)/documents/family_members/$(userId)).data.family_id;
    }

    // ========================================
    // families コレクション
    // ========================================
    match /families/{familyId} {
      // get（ID直接指定）: 認証済みなら可（子アカウント登録時の家族ID確認に必要）
      allow get: if isAuthenticated();
      // list（一覧取得）: 家族メンバーのみ
      allow list: if isAuthenticated() && belongsToFamily(familyId);
      allow create, update: if isAuthenticated() &&
        isParent() &&
        belongsToFamily(familyId);
      allow delete: if false;
    }

    // ========================================
    // users コレクション
    // ========================================
    match /users/{userId} {
      // 読み取り: 自分のドキュメント、または同一家族の親（履歴ページの担当者名表示に必要）
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (isParent() && getUserFamilyId(userId) == getFamilyId())
      );

      // 自分のデータのみ作成可能
      allow create: if isAuthenticated() &&
        request.auth.uid == userId;

      // 更新ルール
      allow update: if isAuthenticated() && (
        // ケース1: 自分が name 等を更新（total_reward の自己変更は不可）
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['total_reward'])
        ) ||
        // ケース2: 親による total_reward 更新（タスク承認・交換返金）
        (
          isParent() &&
          getUserFamilyId(userId) == getFamilyId() &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['total_reward'])
        ) ||
        // ケース3: 子による total_reward 減算（ご褒美交換申請時のポイント確保）
        (
          isChild() &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['total_reward']) &&
          request.resource.data.total_reward >= 0
        )
      );

      allow delete: if false;
    }

    // ========================================
    // family_members コレクション
    // ========================================
    match /family_members/{memberId} {
      // 自分のレコード、または同一家族の親が読み取り可能
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        (
          isParent() &&
          resource.data.family_id == getFamilyId()
        )
      );

      // 初回登録時のみ作成可能（自分のレコードのみ）
      allow create: if isAuthenticated() &&
        request.resource.data.user_id == request.auth.uid;

      // user_id は変更不可。family_id は未設定からの初回設定のみ許可（設定後は変更不可）
      allow update: if isAuthenticated() &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.user_id == resource.data.user_id &&
        (
          !('family_id' in resource.data) ||
          request.resource.data.family_id == resource.data.family_id
        );

      allow delete: if false;
    }

    // ========================================
    // tasks コレクション
    // ========================================
    match /tasks/{taskId} {

      // 読み取り: 同じ家族のメンバーのみ
      allow read: if isAuthenticated() &&
        belongsToFamily(resource.data.family_id);

      // 作成: 親のみ
      allow create: if isAuthenticated() &&
        isParent() &&
        belongsToFamily(request.resource.data.family_id) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasAll([
          'family_id', 'title', 'reward_points', 'status', 'created_by'
        ]) &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.reward_points is int &&
        request.resource.data.reward_points > 0;

      // 更新: ステータス遷移ごとに厳格にルールを分ける
      allow update: if isAuthenticated() && (
        isValidStart()      ||
        isValidCompletion() ||
        isValidApproval()   ||
        isValidRejection()  ||
        isValidEdit()
      );

      // 削除: 親のみ、pending のみ
      allow delete: if isAuthenticated() &&
        isParent() &&
        belongsToFamily(resource.data.family_id) &&
        resource.data.status == 'pending';
    }

    // ----------------------------------------
    // pending → working（子供がタスクを開始）
    // ----------------------------------------
    function isValidStart() {
      return (
        isChild() &&
        belongsToFamily(resource.data.family_id) &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'working' &&
        (
          !('assigned_to' in resource.data) ||
          resource.data.assigned_to == null ||
          resource.data.assigned_to == request.auth.uid
        ) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'assigned_to']) &&
        request.resource.data.family_id == resource.data.family_id &&
        request.resource.data.reward_points == resource.data.reward_points &&
        request.resource.data.created_by == resource.data.created_by
      );
    }

    // ----------------------------------------
    // working → completed（子供がタスクを完了報告）
    // ----------------------------------------
    function isValidCompletion() {
      return (
        isChild() &&
        belongsToFamily(resource.data.family_id) &&
        resource.data.status == 'working' &&
        request.resource.data.status == 'completed' &&
        resource.data.assigned_to == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'completed_at']) &&
        request.resource.data.family_id == resource.data.family_id &&
        request.resource.data.reward_points == resource.data.reward_points &&
        request.resource.data.created_by == resource.data.created_by
      );
    }

    // ----------------------------------------
    // completed → approved（親が承認）
    // ----------------------------------------
    function isValidApproval() {
      return (
        isParent() &&
        belongsToFamily(resource.data.family_id) &&
        resource.data.status == 'completed' &&
        request.resource.data.status == 'approved' &&
        'assigned_to' in resource.data &&
        resource.data.assigned_to != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'approved_at']) &&
        request.resource.data.family_id == resource.data.family_id &&
        request.resource.data.reward_points == resource.data.reward_points &&
        request.resource.data.assigned_to == resource.data.assigned_to
      );
    }

    // ----------------------------------------
    // pending のフィールド編集（親のみ・title/description/reward_points）
    // ----------------------------------------
    function isValidEdit() {
      return (
        isParent() &&
        belongsToFamily(resource.data.family_id) &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'description', 'reward_points', 'assigned_to']) &&
        request.resource.data.family_id == resource.data.family_id &&
        request.resource.data.created_by == resource.data.created_by &&
        request.resource.data.reward_points is int &&
        request.resource.data.reward_points > 0
      );
    }

    // ----------------------------------------
    // completed または working → pending（親が差し戻し）
    // ----------------------------------------
    function isValidRejection() {
      return (
        isParent() &&
        belongsToFamily(resource.data.family_id) &&
        (resource.data.status == 'completed' || resource.data.status == 'working') &&
        request.resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'assigned_to']) &&
        !('assigned_to' in request.resource.data) &&
        request.resource.data.family_id == resource.data.family_id &&
        request.resource.data.reward_points == resource.data.reward_points
      );
    }


    // ========================================
    // rewards コレクション（ご褒美マスター）
    // ========================================
    match /rewards/{rewardId} {
      // 読み取り: 同じ家族のメンバーのみ
      allow read: if isAuthenticated() &&
        belongsToFamily(resource.data.family_id);

      // 作成: 親のみ
      allow create: if isAuthenticated() &&
        isParent() &&
        belongsToFamily(request.resource.data.family_id) &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.required_points is int &&
        request.resource.data.required_points > 0 &&
        request.resource.data.is_active == true;

      // 更新: 親のみ（論理削除・編集を含む）
      allow update: if isAuthenticated() &&
        isParent() &&
        belongsToFamily(resource.data.family_id) &&
        request.resource.data.family_id == resource.data.family_id &&
        request.resource.data.created_by == resource.data.created_by;

      // 物理削除禁止（過去の交換履歴保護）
      allow delete: if false;
    }

    // ========================================
    // exchanges コレクション（交換履歴）
    // ========================================
    match /exchanges/{exchangeId} {
      // 読み取り: 同じ家族のメンバーのみ
      allow read: if isAuthenticated() &&
        belongsToFamily(resource.data.family_id);

      // 作成: 子供のみ（申請）
      allow create: if isAuthenticated() &&
        isChild() &&
        belongsToFamily(request.resource.data.family_id) &&
        request.resource.data.status == 'requested' &&
        request.resource.data.requested_by == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'family_id', 'reward_id', 'reward_title', 'child_name',
          'required_points', 'status', 'requested_by',
          'created_at', 'updated_at'
        ]);

      // 更新: 親のみ（deliver/reject）
      // 状態遷移は requested → delivered または rejected のみ
      allow update: if isAuthenticated() &&
        isParent() &&
        belongsToFamily(resource.data.family_id) &&
        resource.data.status == 'requested' &&
        (request.resource.data.status == 'delivered' ||
          request.resource.data.status == 'rejected') &&
        request.resource.data.requested_by == resource.data.requested_by &&
        request.resource.data.required_points == resource.data.required_points;

      // 削除禁止（監査ログ保護）
      allow delete: if false;
    }

    // ========================================
    // reward_exchanges コレクション（即時交換履歴）
    // クライアントSDKからのアクセスを完全遮断
    // 書き込みは Admin SDK Server Action のみ
    // ========================================
    match /reward_exchanges/{docId} {
      allow read, write: if false;
    }

    // ========================================
    // idempotency_keys コレクション（冪等性キー）
    // クライアントSDKからのアクセスを完全遮断
    // ========================================
    match /idempotency_keys/{docId} {
      allow read, write: if false;
    }

  }
}